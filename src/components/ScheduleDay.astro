---
export interface Props {
  name: string;
  date: string;
  topic: string;
  time?: string;
  isOff?: boolean;
  isToday?: boolean;
}

const { name, date, topic, time = '—', isOff = false, isToday = false } = Astro.props;
---
<div class={`schedule-day${isToday ? ' today' : ''}`}>
  <div class="day-name">{name}</div>
  <div class="day-date">{date}</div>
  <div class={`schedule-slot${isOff ? ' is-off' : ''}`}>
    <span class="time">{time}</span>
    <span class="topic">{topic}</span>
  </div>
</div>
