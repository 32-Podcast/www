---
import ThemeDropdown from './ThemeDropdown.astro';
import { site, type NavItem } from '../data/site';

export interface Props {
  items: NavItem[];
  activeNav?: string;
}

const { items, activeNav = '' } = Astro.props;

const mainItems = items.filter(i => ['/', '/episodes', '/rubrics', '/schedule'].includes(i.href));
const moreItems = items.filter(i => !['/', '/episodes', '/rubrics', '/schedule'].includes(i.href));
---

<header class="navbar">
  <div class="container">
    <div class="navbar-inner">
      <a href="/" class="navbar-brand">
        32 Подкаст
      </a>
      <nav class="navbar-center">
        {mainItems.map(item => (
          <a href={item.href} class={item.href === activeNav ? 'active' : ''}>{item.label}</a>
        ))}
        <div class="nav-more">
          <button class="nav-more-btn" onclick="toggleMoreMenu(event)" aria-label="Още">Още <i class="fas fa-chevron-down" style="font-size:0.55rem"></i></button>
          <div class="nav-more-menu" id="moreMenu">
            {moreItems.map(item => (
              <a href={item.href} class={item.href === activeNav ? 'active' : ''}>{item.label}</a>
            ))}
          </div>
        </div>
      </nav>
      <div class="navbar-actions">
        <ThemeDropdown />
        <button class="mobile-hamburger" onclick="toggleMobileMenu()" aria-label="Меню">
          <i class="fas fa-bars"></i>
        </button>
      </div>
    </div>
  </div>
</header>