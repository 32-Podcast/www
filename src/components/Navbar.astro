---
import ThemeDropdown from './ThemeDropdown.astro';
import { type NavItem } from '../data/site';

export interface Props {
  items: NavItem[];
  activeNav?: string;
}

const { items, activeNav = '' } = Astro.props;
---

<header class="navbar">
  <div class="container">
    <div class="navbar-inner">
      <a href="/" class="navbar-brand">
        <img src="/images/logo32.png" alt="" class="navbar-logo">
        <span class="accent">ПОДКАСТ</span>
      </a>
      <nav class="navbar-center">
        {items.map(item => (
          <a href={item.href} class={item.href === activeNav ? 'active' : ''}>{item.label}</a>
        ))}
      </nav>
      <div class="navbar-actions">
        <button class="navbar-menu-toggle" type="button" aria-label="Отвори меню" aria-expanded="false">
          <i class="fas fa-bars" aria-hidden="true"></i>
        </button>
        <ThemeDropdown />
      </div>
    </div>
    <nav class="navbar-mobile-menu" aria-label="Мобилна навигация">
      {items.map(item => (
        <a href={item.href} class={item.href === activeNav ? 'active' : ''}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
