---
import ThemeDropdown from './ThemeDropdown.astro';
import { site, type NavItem } from '../data/site';

export interface Props {
  items: NavItem[];
  activeNav?: string;
}

const { items, activeNav = '' } = Astro.props;
---

<header class="navbar">
  <div class="container">
    <div class="navbar-inner">
      <a href="/" class="navbar-brand">
        32 <span class="accent">ПОДКАСТ</span>
      </a>
      <nav class="navbar-center">
        {items.map(item => (
          <a href={item.href} class={item.href === activeNav ? 'active' : ''}>{item.label}</a>
        ))}
      </nav>
      <div class="navbar-actions">
        <ThemeDropdown />
        <button class="mobile-hamburger" onclick="toggleMobileMenu()" aria-label="Меню">
          <i class="fas fa-bars"></i>
        </button>
      </div>
    </div>
  </div>
</header>
