---
import { type Episode, youtubeUrl, thumbnailUrl } from '../data/episodes';

export interface Props {
  episode: Episode;
}
const { episode } = Astro.props;
const url = youtubeUrl(episode.id);
const thumb = thumbnailUrl(episode.id);
---
<article class="episode-card reveal">
  <a href={url} target="_blank" class="episode-thumb-link" rel="noopener">
    <div class="episode-thumb">
      <img src={thumb} alt="" loading="lazy">
      <div class="thumb-title-overlay">
        {episode.label && <span class="thumb-label">{episode.label}</span>}
        <h4>{episode.title}</h4>
      </div>
      <span class="play-overlay"><i class="fas fa-play"></i></span>
    </div>
  </a>
  <div class="episode-info">
    {episode.label && <span class="episode-tag">{episode.label}</span>}
    <h4>{episode.title}</h4>
    {episode.description && <p>{episode.description}</p>}
    <a href={url} target="_blank" rel="noopener" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:0.75rem;">
      <i class="fab fa-youtube"></i> Гледай в YouTube
    </a>
  </div>
</article>
