---
import { youtubeChannel, facebookPage, instagramPage, spotifyShow } from '../data/site';
---
<div class="social-links" style="margin-top:1.25rem;">
  <a href={facebookPage} target="_blank" rel="noopener" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
  <a href={youtubeChannel} target="_blank" rel="noopener" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
  <a href={instagramPage} target="_blank" rel="noopener" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
  <a href={spotifyShow} target="_blank" rel="noopener" aria-label="Spotify"><i class="fab fa-spotify"></i></a>
</div>
