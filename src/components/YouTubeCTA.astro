---
import { youtubeChannel } from '../data/site';

export interface Props {
  description?: string;
}

const { description = 'Абонирай се за нашия YouTube канал, за да не пропуснеш нито един епизод. Нови предавания всяка седмица!' } = Astro.props;
---
<div class="youtube-card">
  <div class="youtube-logo"><i class="fab fa-youtube"></i></div>
  <h3>@schoolpodcast32</h3>
  <p>{description}</p>
  <a href={youtubeChannel} target="_blank" rel="noopener" class="youtube-btn">
    <i class="fab fa-youtube"></i> Посети канала
  </a>
</div>
