---
import { site, type NavItem } from '../data/site';

export interface Props {
  items: NavItem[];
}

const { items } = Astro.props;

const podcastLinks = items.filter(i => ['/', '/episodes', '/rubrics', '/schedule'].includes(i.href));
const aboutLinks = items.filter(i => ['/team', '/guests', '/contact'].includes(i.href));

const youtubeChannel = site.youtubeChannel;
const facebookPage = site.facebookPage;
const instagramPage = site.instagramPage;
const schoolSite = site.schoolSite;
const githubOrg = site.githubOrg;
const spotifyShow = site.spotifyShow;
---

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="footer-brand-name">32 Подкаст</div>
      <p class="footer-desc">Училищно радио "32 Подкаст" — гласът на 32. СУИЧЕ "Св. Климент Охридски".</p>
      <div class="footer-socials">
        <a href={facebookPage} target="_blank" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
        <a href={youtubeChannel} target="_blank" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
        <a href={instagramPage} target="_blank" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
        <a href={spotifyShow} target="_blank" rel="noopener" aria-label="Spotify"><i class="fab fa-spotify"></i></a>
        <a href={githubOrg} target="_blank" rel="noopener" aria-label="GitHub"><i class="fab fa-github"></i></a>
      </div>
    </div>

    <div class="footer-links">
      <div class="footer-col">
        <h4>Подкаст</h4>
        {podcastLinks.map(i => <a href={i.href}>{i.label}</a>)}
      </div>
      <div class="footer-col">
        <h4>За нас</h4>
        {aboutLinks.map(i => <a href={i.href}>{i.label}</a>)}
        <a href={youtubeChannel} target="_blank">YouTube</a>
      </div>
      <div class="footer-col">
        <h4>Училище</h4>
        <a href={schoolSite} target="_blank">32. СУИЧЕ</a>
        <a href={`${schoolSite}/новини/`} target="_blank">Новини</a>
        <a href={`${schoolSite}/прием/`} target="_blank">Прием</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>Copyright 2026 &copy; 32. СУИЧЕ "Св. Климент Охридски"</p>
  </div>
</footer>