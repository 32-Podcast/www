---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { youtubeChannel } from '../data/site';

const now = new Date();
const year = now.getFullYear();
const month = now.getMonth();
const monthNames = ['Януари', 'Февруари', 'Март', 'Април', 'Май', 'Юни', 'Юли', 'Август', 'Септември', 'Октомври', 'Ноември', 'Декември'];
const weekdayNames = ['Пон', 'Вто', 'Сря', 'Чет', 'Пет', 'Съб', 'Нед'];

const firstDay = new Date(year, month, 1);
const daysInMonth = new Date(year, month + 1, 0).getDate();
const firstDayBulgarian = (firstDay.getDay() + 6) % 7;
const today = now.getDate();

const cells: { day: number | null; isToday: boolean }[] = [];
for (let i = 0; i < firstDayBulgarian; i++) {
  cells.push({ day: null, isToday: false });
}
for (let d = 1; d <= daysInMonth; d++) {
  cells.push({ day: d, isToday: d === today });
}
while (cells.length % 7 !== 0) {
  cells.push({ day: null, isToday: false });
}
---
<BaseLayout title="Програма" description="Месечна програма на 32 Подкаст — следи за новите епизоди през целия месец." activeNav="/schedule">
  <div class="container">
    <PageHeader title="Месечна програма" current="Програма" description="Виж кога излизат любимите ти рубрики и не пропускай нищо" />
  </div>

  <div class="container">
    <section style="padding-top:0;">
      <div class="calendar reveal">
        <div class="calendar-header">
          <h2>{monthNames[month]} {year}</h2>
        </div>
        <div class="calendar-weekdays">
          {weekdayNames.map(d => <div class="weekday">{d}</div>)}
        </div>
        <div class="calendar-grid">
          {cells.map(c => (
            <div class:list={["calendar-cell", !c.day && "empty", c.isToday && "today"]}>
              {c.day !== null && <span class="cell-day">{c.day}</span>}
            </div>
          ))}
        </div>
      </div>
      <div style="text-align:center;margin-top:2.5rem;" class="reveal">
        <p style="color:var(--color-ink);opacity:0.6;margin-bottom:1rem;">
          <i class="fas fa-info-circle" style="color:var(--color-coral);"></i>
          Всички предавания се качват на YouTube за гледане по всяко време.
        </p>
        <a href={youtubeChannel} target="_blank" rel="noopener" class="btn btn-primary">
          <i class="fab fa-youtube"></i> Абонирай се
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
