---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { youtubeChannel } from '../data/site';
import { events } from '../data/events';

const now = new Date();
const currentMonth = now.getMonth();
const currentYear = now.getFullYear();

const urlMonth = Number(Astro.url.searchParams.get('month'));
const urlYear = Number(Astro.url.searchParams.get('year'));
const year = !isNaN(urlYear) && urlYear > 1970 ? urlYear : currentYear;
const month = !isNaN(urlMonth) && urlMonth >= 0 && urlMonth <= 11 ? urlMonth : currentMonth;

const monthNames = ['Януари', 'Февруари', 'Март', 'Април', 'Май', 'Юни', 'Юли', 'Август', 'Септември', 'Октомври', 'Ноември', 'Декември'];
const weekdayNames = ['Пон', 'Вто', 'Сря', 'Чет', 'Пет', 'Съб', 'Нед'];

const firstDay = new Date(year, month, 1);
const daysInMonth = new Date(year, month + 1, 0).getDate();
const firstDayBulgarian = (firstDay.getDay() + 6) % 7;
const isCurrentMonth = year === currentYear && month === currentMonth;
const today = isCurrentMonth ? now.getDate() : -1;

const prevMonth = month === 0 ? 11 : month - 1;
const prevYear = month === 0 ? year - 1 : year;
const nextMonth = month === 11 ? 0 : month + 1;
const nextYear = month === 11 ? year + 1 : year;

const monthEvents = events.filter(e => {
  const [y, m] = e.date.split('-').map(Number);
  return y === year && m - 1 === month;
});
const eventsByDay = new Map<number, { label: string; weekday: string }>();
for (const e of monthEvents) {
  const [y, m, d] = e.date.split('-').map(Number);
  const dt = new Date(y, m - 1, d);
  const wd = (dt.getDay() + 6) % 7;
  eventsByDay.set(d, { label: e.label, weekday: weekdayNames[wd] });
}

const cells: { day: number | null; isToday: boolean; eventLabel?: string; eventWeekday?: string }[] = [];
for (let i = 0; i < firstDayBulgarian; i++) {
  cells.push({ day: null, isToday: false });
}
for (let d = 1; d <= daysInMonth; d++) {
  const ev = eventsByDay.get(d);
  cells.push({ day: d, isToday: d === today, eventLabel: ev?.label, eventWeekday: ev?.weekday });
}
while (cells.length % 7 !== 0) {
  cells.push({ day: null, isToday: false });
}
---
<BaseLayout title="Програма" description="Месечна програма на 32 Подкаст — следи за новите епизоди през целия месец." activeNav="/schedule">
  <div class="container">
    <PageHeader title="Месечна програма" current="Програма" description="Виж кога излизат любимите ти рубрики и не пропускай нищо" />
  </div>

  <div class="container">
    <section style="padding-top:0;">
      <div class="calendar reveal">
        <div class="calendar-nav">
          <a href={`/schedule?month=${prevMonth + 1}&year=${prevYear}`} class="calendar-nav-btn" aria-label="Предишен месец">
            <i class="fas fa-chevron-left"></i>
          </a>
          <h2>{monthNames[month]} {year}</h2>
          <a href={`/schedule?month=${nextMonth + 1}&year=${nextYear}`} class="calendar-nav-btn" aria-label="Следващ месец">
            <i class="fas fa-chevron-right"></i>
          </a>
        </div>
        {!isCurrentMonth && (
          <div style="text-align:center;margin-bottom:1rem;">
            <a href="/schedule" class="calendar-today-btn">
              <i class="fas fa-calendar-day"></i> Към днешния месец
            </a>
          </div>
        )}
        <div class="calendar-weekdays">
          {weekdayNames.map(d => <div class="weekday">{d}</div>)}
        </div>
        <div class="calendar-grid">
          {cells.map(c => (
            <div class:list={["calendar-cell", !c.day && "empty", c.isToday && "today", c.eventLabel && "has-event"]}>
              {c.day !== null && (
                <>
                  <span class="cell-day">{c.day}</span>
                  {c.eventLabel && (
                    <span class="event-badge" title={`${c.eventWeekday} · ${c.eventLabel}`}>
                      <span class="event-weekday">{c.eventWeekday}</span>
                      {c.eventLabel}
                    </span>
                  )}
                </>
              )}
            </div>
          ))}
        </div>
      </div>
      <div style="text-align:center;margin-top:2.5rem;" class="reveal">
        <p style="color:var(--color-ink);opacity:0.6;margin-bottom:1rem;">
          <i class="fas fa-info-circle" style="color:var(--color-coral);"></i>
          Всички предавания се качват на YouTube за гледане по всяко време.
        </p>
        <a href={youtubeChannel} target="_blank" rel="noopener" class="btn btn-primary">
          <i class="fab fa-youtube"></i> Абонирай се
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
