---
import BaseLayout from '../layouts/BaseLayout.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import TeamCard from '../components/TeamCard.astro';
import { latestEpisodes, episodes } from '../data/episodes';
import { team } from '../data/team';

const latest = latestEpisodes(4);
const featured = latest[0];
---

<BaseLayout title="32 Подкаст | Гласът на 32. СУИЧЕ" activeNav="/">
  <section class="new-hero">
    <div class="new-hero-top">
      <p class="eyebrow">32. СУИЧЕ / София / 2026</p>
      <p class="hero-index">01 — 04</p>
    </div>
    <div class="new-hero-layout">
      <div class="new-hero-copy">
        <h1>Тук<br><span>говорим</span><br>истински.</h1>
        <p class="new-hero-intro">Ученическият подкаст на 32. СУИЧЕ. Идеи, хора и истории, които заслужават да бъдат чути.</p>
        <div class="new-hero-actions">
          <a href={`https://www.youtube.com/watch?v=${featured.id}`} target="_blank" rel="noopener" class="tactile-button"><span>Чуй последния епизод</span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></a>
          <span class="hero-scroll"><i class="fas fa-arrow-down"></i> Скролни надолу</span>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-image-wrap">
          <img src={`https://i.ytimg.com/vi/${featured.id}/hqdefault.jpg`} alt={featured.title}>
          <div class="hero-image-overlay"></div>
        </div>
      </div>
    </div>
    <div class="hero-marquee" aria-label="32 Подкаст теми">
      <div class="hero-marquee-track"><span>ИДЕИ</span><i>✳</i><span>ИСТОРИИ</span><i>✳</i><span>РАЗГОВОРИ</span><i>✳</i><span>32 ПОДКАСТ</span><i>✳</i><span>ИДЕИ</span><i>✳</i><span>ИСТОРИИ</span><i>✳</i><span>РАЗГОВОРИ</span><i>✳</i><span>32 ПОДКАСТ</span><i>✳</i></div>
    </div>
  </section>

  <section class="intro-strip">
    <div class="container intro-grid">
      <p class="eyebrow">/ Какво е 32?</p>
      <p class="intro-statement">Не е просто подкаст. Това е мястото, където училището излиза от рамката си.</p>
      <div class="intro-stat"><strong>{episodes.length}</strong><span>издадени<br>епизода</span></div>
    </div>
  </section>

  <section class="new-episodes" id="latest">
    <div class="container">
      <div class="new-section-head">
        <div><p class="eyebrow">/ Последни епизоди</p><h2>В ефир<br><em>сега.</em></h2></div>
        <a href="/episodes" class="text-link">Виж всички <i class="fas fa-arrow-right"></i></a>
      </div>
      <div class="new-feature">
        <a class="new-feature-image" href={`https://www.youtube.com/watch?v=${featured.id}`} target="_blank" rel="noopener">
          <img src={`https://i.ytimg.com/vi/${featured.id}/hqdefault.jpg`} alt={featured.title}>
          <span class="new-play"><i class="fas fa-play"></i></span>
        </a>
        <div class="new-feature-info">
          <p class="eyebrow">ЕП.{featured.order} / НОВ ЕПИЗОД</p>
          <h3>{featured.title}</h3>
          <p>Разговори от училището, направени от ученици за всички, които искат да слушат.</p>
          <a href={`https://www.youtube.com/watch?v=${featured.id}`} target="_blank" rel="noopener" class="text-link">Гледай епизода <i class="fas fa-arrow-up-right-from-square"></i></a>
        </div>
      </div>
      <div class="new-episode-grid">
        {latest.slice(1).map(ep => <EpisodeCard episode={ep} />)}
      </div>
    </div>
  </section>

  <section class="new-team">
    <div class="container">
      <div class="new-section-head">
        <div><p class="eyebrow">/ Екип</p><h2>Зад<br><em>подкаста.</em></h2></div>
        <div class="team-head-note"><p>Това са хората, които измислят темите, подготвят снимките, обработват звука и превръщат всяка идея в епизод.</p><a href="/team" class="text-link">Виж екипа <i class="fas fa-arrow-right"></i></a></div>
      </div>
      <div class="team-grid-asymmetric">{team.map(member => <TeamCard member={member} />)}</div>
    </div>
  </section>

  <section class="new-cta">
    <div class="cta-number">32</div>
    <p class="eyebrow">/ Твоят ред</p>
    <h2>Имаш<br><span>какво да кажеш?</span></h2>
    <a href="/contact" class="tactile-button tactile-button-dark"><span>Пиши ни</span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></a>
  </section>
</BaseLayout>
