---
import BaseLayout from '../layouts/BaseLayout.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import TeamCard from '../components/TeamCard.astro';
import YouTubeCTA from '../components/YouTubeCTA.astro';
import { latestEpisodes, episodes } from '../data/episodes';
import { team } from '../data/team';
import { site } from '../data/site';

const latest = latestEpisodes(3);
const stats = {
  episodes: episodes.length,
  team: team.length,
  rubrics: 2,
};

const youtubeChannel = site.youtubeChannel;
---
<BaseLayout title="32 Подкаст | 32. СУИЧЕ &quot;Св. Климент Охридски&quot;" activeNav="/">
  <section class="hero" id="header">
    <canvas class="hero-canvas" id="heroCanvas"></canvas>
    <div class="hero-content">
      <div class="hero-tag">Училищно радио — 32. СУИЧЕ</div>
      <h1>32 <span class="accent">ПОДКАСТ</span></h1>
      <p class="hero-subtitle">Твоят глас в ефира</p>
      <div class="hero-cta">
        <a href={youtubeChannel} target="_blank" rel="noopener" class="btn btn-accent">
          <i class="fab fa-youtube"></i> Гледай
        </a>
        <a href="/episodes" class="btn btn-ghost">
          Епизоди <i class="fas fa-arrow-right"></i>
        </a>
      </div>
    </div>
    <div class="hero-scroll" aria-hidden="true">scroll</div>
  </section>

  <div class="container">
    <section>
      <div class="stats-grid reveal" id="statsGrid">
        <div class="stat-item">
          <div class="number" data-target={stats.episodes}>0</div>
          <div class="label">Епизода</div>
        </div>
        <div class="stat-item">
          <div class="number" data-target={stats.team}>0</div>
          <div class="label">Членове</div>
        </div>
        <div class="stat-item">
          <div class="number" data-target={stats.rubrics}>0</div>
          <div class="label">Рубрики</div>
        </div>
      </div>
    </section>
  </div>

  <div class="container">
    <section>
      <div style="margin-bottom:2.5rem;">
        <div class="section-tag">Рубрики</div>
        <div class="section-title">Какво предлагаме</div>
        <p class="section-desc">Всяка рубрика носи различен поглед върху училищния живот</p>
      </div>
      <div class="features-grid">
        <div class="feature-item">
          <div class="ficon"><i class="fas fa-comments"></i></div>
          <div class="finfo">
            <h4>Междучасие</h4>
            <p>Ученици и учители провеждат разговор върху актуална тема</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="ficon"><i class="fas fa-star"></i></div>
          <div class="finfo">
            <h4>SPECIAL</h4>
            <p>Специални епизоди с личности от училището и не само</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="container">
    <section>
      <div class="about-grid">
        <div class="about-image">
          <img src="https://images.unsplash.com/photo-1590602847861-f357a9332bbc?w=800&h=600&fit=crop" alt="Радио студио">
          <div class="floating-card">
            <div class="finfo">
              <h4>2024</h4>
              <span>Старт</span>
            </div>
          </div>
        </div>
        <div class="about-content">
          <div class="section-tag">За подкаста</div>
          <h3>Дигитално преживяване за цялото училище</h3>
          <p>"32 Подкаст" е училищното радио на 32. СУИЧЕ "Св. Климент Охридски" — мястото, където учениците дават глас на своите идеи, таланти и страсти.</p>
          <p>Интервюта, музика, забавни рубрики и много настроение!</p>
        </div>
      </div>
    </section>
  </div>

  <div class="team-section">
    <div class="container">
      <section>
        <div style="margin-bottom:2.5rem;">
          <div class="section-tag">Екип</div>
          <div class="section-title">Хората зад микрофона</div>
          <p class="section-desc">Талантливи ученици, които правят всяко предаване незабравимо</p>
        </div>
        <div class="team-grid">
          {team.map(m => <TeamCard member={m} />)}
        </div>
      </section>
    </div>
  </div>

  <div class="container">
    <section>
      <div style="margin-bottom:2.5rem;">
        <div class="section-tag">YouTube</div>
        <div class="section-title">Гледай ни онлайн</div>
        <p class="section-desc">Всички епизоди на едно място</p>
      </div>
      <YouTubeCTA />
    </section>
  </div>

  <div class="container">
    <section>
      <div style="margin-bottom:2.5rem;">
        <div class="section-tag">Последни</div>
        <div class="section-title">Най-новите предавания</div>
        <p class="section-desc">Започни от тук, ако си нов в подкаста</p>
      </div>
      <div class="episodes-grid">
        {latest.map(ep => <EpisodeCard episode={ep} />)}
      </div>
      <div style="margin-top:2rem;">
        <a href="/episodes" class="btn btn-primary">Всички епизоди <i class="fas fa-arrow-right"></i></a>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
(function() {
  // === CANVAS — noise + floating particles ===
  var canvas = document.getElementById('heroCanvas');
  if (canvas) {
    var ctx = canvas.getContext('2d');
    var w, h, particles = [], scrollY = 0;
    var isDark = document.documentElement.getAttribute('data-theme') === 'dark' ||
                 document.documentElement.getAttribute('data-theme') === 'catppuccin';

    function resize() {
      w = canvas.width = canvas.offsetWidth;
      h = canvas.height = canvas.offsetHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    // Create particles
    for (var i = 0; i < 60; i++) {
      particles.push({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        r: Math.random() * 2 + 0.5,
        alpha: Math.random() * 0.3 + 0.05
      });
    }

    function drawFrame() {
      var accentColor = isDark ? [255, 61, 0] : [10, 10, 10];
      ctx.clearRect(0, 0, w, h);

      // Draw particles
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0) p.x = w;
        if (p.x > w) p.x = 0;
        if (p.y < 0) p.y = h;
        if (p.y > h) p.y = 0;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(' + accentColor[0] + ',' + accentColor[1] + ',' + accentColor[2] + ',' + p.alpha + ')';
        ctx.fill();
      }

      // Draw connecting lines between close particles
      for (var i = 0; i < particles.length; i++) {
        for (var j = i + 1; j < particles.length; j++) {
          var dx = particles[i].x - particles[j].x;
          var dy = particles[i].y - particles[j].y;
          var dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 120) {
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = 'rgba(' + accentColor[0] + ',' + accentColor[1] + ',' + accentColor[2] + ',' + (0.05 * (1 - dist / 120)) + ')';
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(drawFrame);
    }
    drawFrame();

    // Update theme on change
    var origSetTheme = window.setTheme;
    window.setTheme = function(n) {
      origSetTheme(n);
      isDark = n === 'dark' || n === 'catppuccin';
    };
  }

  // === Stats counter ===
  var grid = document.getElementById('statsGrid');
  if (grid) {
    var numbers = grid.querySelectorAll('.number');
    var played = false;
    if (!('IntersectionObserver' in window)) {
      numbers.forEach(function(n) { n.textContent = n.getAttribute('data-target'); });
    } else {
      var obs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting || played) return;
          played = true;
          numbers.forEach(function(num) {
            var t = parseInt(num.getAttribute('data-target'), 10) || 0;
            var c = 0;
            var inc = t / 40;
            var timer = setInterval(function() {
              c += inc;
              if (c >= t) { num.textContent = t; clearInterval(timer); }
              else { num.textContent = Math.floor(c); }
            }, 30);
          });
        });
      }, { threshold: 0.5 });
      obs.observe(grid);
    }
  }
})();
</script>
