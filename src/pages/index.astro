---
import BaseLayout from '../layouts/BaseLayout.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import TeamCard from '../components/TeamCard.astro';
import { latestEpisodes, episodes } from '../data/episodes';
import { team } from '../data/team';
import { site } from '../data/site';

const latest = latestEpisodes(6);
const stats = {
  episodes: episodes.length,
  team: team.length,
  rubrics: 2,
};

const youtubeChannel = site.youtubeChannel;
---
<BaseLayout title="32 Подкаст | 32. СУИЧЕ &quot;Св. Климент Охридски&quot;" activeNav="/">
  <section class="home-hero" id="header">
    <canvas class="hero-canvas" id="heroCanvas"></canvas>
    <div class="home-hero-grid">
      <div class="home-hero-copy">
        <div class="hero-tag"><span class="live-dot"></span> Училищно радио — 32. СУИЧЕ</div>
        <h1 class="home-title">
          <span id="heroLine1">Истории</span>
          <span id="heroLine2">от 32.</span>
          <em>подкаст</em>
        </h1>
        <p class="home-hero-subtitle">Интервюта, музика и истории от училищния живот — направени от ученици, за ученици.</p>
        <div class="hero-cta">
          <a href={youtubeChannel} target="_blank" rel="noopener" class="btn btn-accent"><i class="fab fa-youtube"></i> Слушай последния епизод</a>
          <a href="#episodes" class="btn btn-ghost">Разгледай предаванията <i class="fas fa-arrow-down"></i></a>
        </div>
      </div>
      <div class="studio-card">
        <div class="studio-card-top"><span>ON AIR</span><span>32 / 01</span></div>
        <div class="studio-disc"><span class="disc-label">32<br>FM</span></div>
        <div class="waveform" aria-label="Аудио визуализация">
          {Array.from({ length: 24 }).map((_, index) => <i style={`--bar:${(index % 7) + 2}`}></i>)}
        </div>
        <div class="studio-card-bottom"><span>Училищният глас</span><span>София, BG</span></div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <div class="container">
    <section>
      <div class="stats-inline reveal" id="statsGrid">
        <div class="stat-item">
          <div class="number" data-target={stats.episodes}>0</div>
          <div class="label">Епизода</div>
        </div>
        <div class="stat-item">
          <div class="number" data-target={stats.team}>0</div>
          <div class="label">Членове</div>
        </div>
        <div class="stat-item">
          <div class="number" data-target={stats.rubrics}>0</div>
          <div class="label">Рубрики</div>
        </div>
      </div>
    </section>
  </div>

  <!-- EPISODES — KINETIC STICKY HEADER + MASONRY -->
  <div class="kinetic-section home-section" id="episodes">
    <div class="kinetic-header" id="episodesHeader">
      <h2 id="episodesTitle">ЕПИЗОДИ</h2>
      <div class="kinetic-count">{episodes.length} епизода</div>
    </div>
    <div class="kinetic-content">
      <div class="episodes-masonry">
        {latest.map(ep => <EpisodeCard episode={ep} />)}
      </div>
      <div style="margin-top:2rem;">
        <a href="/episodes" class="btn btn-primary">Всички епизоди <i class="fas fa-arrow-right"></i></a>
      </div>
    </div>
  </div>

  <!-- RUBRICS — STACKED BLOCKS WITH LEFT ACCENT -->
  <div class="kinetic-section home-section">
    <div class="kinetic-header" id="rubricsHeader">
      <h2 id="rubricsTitle">РУБРИКИ</h2>
      <div class="kinetic-count">2 рубрики</div>
    </div>
    <div class="kinetic-content">
      <div class="rubric-blocks">
        <div class="rubric-block reveal">
          <div class="rubric-accent-bar"></div>
          <div class="rubric-block-inner">
            <h3>МЕЖДУЧАСИЕ</h3>
            <p>Ученици и учители провеждат разговор върху актуална, засягаща много хора тема</p>
            <div class="rubric-actions">
              <a href="/rubrics" class="btn btn-sm btn-ghost">Повече <i class="fas fa-arrow-right"></i></a>
            </div>
          </div>
        </div>
        <div class="rubric-block reveal">
          <div class="rubric-accent-bar"></div>
          <div class="rubric-block-inner">
            <h3>SPECIAL</h3>
            <p>Специални епизоди с личности — директора на училището, учители, външни гости</p>
            <div class="rubric-actions">
              <a href="/rubrics" class="btn btn-sm btn-ghost">Повече <i class="fas fa-arrow-right"></i></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="home-manifesto">
    <div class="container manifesto-grid">
      <div class="manifesto-index">02 / ИДЕЯ</div>
      <div>
        <div class="section-tag">За подкаста</div>
        <h2>Мястото, където училището започва да говори.</h2>
        <p>"32 Подкаст" е училищното радио на 32. СУИЧЕ — платформа за идеи, таланти и разговори, които имат значение.</p>
      </div>
      <div class="manifesto-note">Нови разговори<br><strong>всяка седмица</strong></div>
    </div>
  </section>

  <div class="team-section">
    <div class="container">
      <section>
        <div style="margin-bottom:2rem;">
          <div class="section-tag">Екип</div>
          <div class="section-title">Хората зад микрофона</div>
          <p class="section-desc">Талантливи ученици, които правят всяко предаване незабравимо</p>
        </div>
        <div class="team-grid-asymmetric">
          {team.map(m => <TeamCard member={m} />)}
        </div>
      </section>
    </div>
  </div>

  <section class="youtube-cta-block">
    <h2>ГЛЕДАЙ</h2>
    <p>Всички епизоди на YouTube — абонирай се за нови предавания</p>
    <a href={youtubeChannel} target="_blank" rel="noopener" class="btn">
      <i class="fab fa-youtube"></i> @schoolpodcast32
    </a>
  </section>
</BaseLayout>

<script is:inline>
(function() {
  // === CANVAS — particles + connecting lines ===
  var canvas = document.getElementById('heroCanvas');
  if (canvas) {
    var ctx = canvas.getContext('2d');
    var w, h, particles = [];
    var isDark = document.documentElement.getAttribute('data-theme') === 'dark' ||
                 document.documentElement.getAttribute('data-theme') === 'catppuccin';

    function resize() {
      w = canvas.width = canvas.offsetWidth;
      h = canvas.height = canvas.offsetHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    for (var i = 0; i < 50; i++) {
      particles.push({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4,
        r: Math.random() * 2 + 0.5,
        alpha: Math.random() * 0.25 + 0.05
      });
    }

    function drawFrame() {
      var c = isDark ? [255, 162, 0] : [21, 34, 56];
      ctx.clearRect(0, 0, w, h);
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0) p.x = w;
        if (p.x > w) p.x = 0;
        if (p.y < 0) p.y = h;
        if (p.y > h) p.y = 0;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + p.alpha + ')';
        ctx.fill();
      }
      for (var i = 0; i < particles.length; i++) {
        for (var j = i + 1; j < particles.length; j++) {
          var dx = particles[i].x - particles[j].x;
          var dy = particles[i].y - particles[j].y;
          var dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 100) {
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + (0.04 * (1 - dist / 100)) + ')';
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }
      requestAnimationFrame(drawFrame);
    }
    drawFrame();

    var origSetTheme = window.setTheme;
    window.setTheme = function(n) {
      origSetTheme(n);
      isDark = n === 'dark' || n === 'catppuccin';
    };
  }

  // === SCROLL — kinetic type parallax on hero ===
  var line1 = document.getElementById('heroLine1');
  var line2 = document.getElementById('heroLine2');
  if (line1 && line2) {
    window.addEventListener('scroll', function() {
      var sy = window.scrollY;
      var factor = Math.min(sy / 600, 1);
      line1.style.transform = 'translateX(' + (-60 + factor * 60) + 'px) scale(' + (1 + factor * 0.3) + ')';
      line1.style.opacity = 1 - factor * 0.8;
      line2.style.transform = 'translateX(' + (60 - factor * 60) + 'px) scale(' + (1 + factor * 0.2) + ')';
      line2.style.opacity = 1 - factor * 0.7;
    }, { passive: true });
  }

  // === STATS counter ===
  var grid = document.getElementById('statsGrid');
  if (grid) {
    var numbers = grid.querySelectorAll('.number');
    var played = false;
    if (!('IntersectionObserver' in window)) {
      numbers.forEach(function(n) { n.textContent = n.getAttribute('data-target'); });
    } else {
      var obs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting || played) return;
          played = true;
          numbers.forEach(function(num) {
            var t = parseInt(num.getAttribute('data-target'), 10) || 0;
            var c = 0;
            var inc = t / 40;
            var timer = setInterval(function() {
              c += inc;
              if (c >= t) { num.textContent = t; clearInterval(timer); }
              else { num.textContent = Math.floor(c); }
            }, 30);
          });
        });
      }, { threshold: 0.5 });
      obs.observe(grid);
    }
  }
})();
</script>
