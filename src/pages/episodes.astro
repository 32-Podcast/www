---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import { episodes } from '../data/episodes';

const sort = Astro.url.searchParams.get('sort') === 'oldest' ? 'oldest' : 'newest';
const sorted = [...episodes].sort((a, b) => {
  const diff = new Date(a.date).getTime() - new Date(b.date).getTime();
  return sort === 'oldest' ? diff : -diff;
});
---
<BaseLayout title="Всички епизоди" description="Всички епизоди на 32 Подкаст — гледай предаванията на училищното радио." activeNav="/episodes">
  <div class="container">
    <PageHeader title="Всички епизоди" current="Епизоди" description="Прегледай всички наши предавания и избери своето любимо" />
  </div>

  <div class="container">
    <section style="padding-top:0;">
      <div class="episodes-filter reveal">
        <span class="filter-label">Подреди по:</span>
        <div class="filter-group" role="tablist">
          <a href="/episodes" class:list={["filter-btn", sort === 'newest' && "active"]} role="tab" aria-selected={sort === 'newest'}>
            <i class="fas fa-arrow-down-wide-short"></i> Нови първо
          </a>
          <a href="/episodes?sort=oldest" class:list={["filter-btn", sort === 'oldest' && "active"]} role="tab" aria-selected={sort === 'oldest'}>
            <i class="fas fa-arrow-up-wide-short"></i> Стари първо
          </a>
        </div>
        <span class="filter-count">{episodes.length} епизода</span>
      </div>

      <div class="episodes-grid">
        {sorted.map(ep => <EpisodeCard episode={ep} />)}
      </div>
    </section>
  </div>
</BaseLayout>
