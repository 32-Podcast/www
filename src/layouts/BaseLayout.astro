---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import { navItems } from '../data/site';

export interface Props {
  title: string;
  description?: string;
  activeNav?: string;
}

const {
  title,
  description = 'Училищно радио 32 Подкаст — подкастът на 32. СУИЧЕ. Междучасие и SPECIAL — нови епизоди всяка седмица.',
  activeNav = '',
} = Astro.props;

const fullTitle = title.includes('32 Подкаст') ? title : `${title} | 32 Подкаст`;
---
<!doctype html>
<html lang="bg">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#f76f53">
<link rel="alternate" type="application/rss+xml" title="32 Подкаст" href="/feed.xml">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script is:inline>
  (function(){
    var t = localStorage.getItem('theme');
    if (!t) t = window.matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', t);
  })();
</script>
</head>
<body>
<MobileMenu items={navItems} activeNav={activeNav} />
<Navbar items={navItems} activeNav={activeNav} />

<main>
  <slot />
</main>

<Footer items={navItems} />

<script is:inline>
  (function() {
    function $(s, c) { return (c || document).querySelector(s); }
    function $$(s, c) { return Array.prototype.slice.call((c || document).querySelectorAll(s)); }

    // Navbar scroll shadow
    var header = $('.navbar');
    if (header) {
      window.addEventListener('scroll', function() {
        header.classList.toggle('scrolled', window.scrollY > 50);
      });
    }

    // Mobile menu
    window.toggleMobileMenu = function() {
      $('#mobileMenu').classList.toggle('open');
      $('#mobileOverlay').classList.toggle('open');
      document.body.style.overflow = $('#mobileMenu').classList.contains('open') ? 'hidden' : '';
    };

    // Theme dropdown
    window.toggleDropdown = function(e) {
      e.stopPropagation();
      $('#themeDropdown').classList.toggle('open');
    };

    window.setTheme = function(n) {
      document.documentElement.setAttribute('data-theme', n);
      localStorage.setItem('theme', n);
      var d = $('#themeDropdown'); if (d) d.classList.remove('open');
      var i = $('#themeIcon');
      if (i) i.className = n === 'light' ? 'fas fa-sun' : n === 'dark' ? 'fas fa-moon' : n === 'gruvbox' ? 'fas fa-fire' : n === 'rose-pine' ? 'fas fa-gem' : 'fas fa-palette';
      $$('.theme-dropdown-menu button').forEach(function(b) {
        b.classList.toggle('active', b.getAttribute('data-theme') === n);
      });
    };

    document.addEventListener('click', function() {
      var d = $('#themeDropdown'); if (d) d.classList.remove('open');
    });

    // Init theme icon + active button on page load
    (function() {
      var t = document.documentElement.getAttribute('data-theme');
      var i = $('#themeIcon');
      if (i) i.className = t === 'light' ? 'fas fa-sun' : t === 'dark' ? 'fas fa-moon' : t === 'gruvbox' ? 'fas fa-fire' : t === 'rose-pine' ? 'fas fa-gem' : 'fas fa-palette';
      $$('.theme-dropdown-menu button').forEach(function(b) {
        b.classList.toggle('active', b.getAttribute('data-theme') === t);
      });
    })();

    // Smooth scroll for in-page anchors
    $$('a[href^="#"]').forEach(function(a) {
      a.addEventListener('click', function(e) {
        var href = a.getAttribute('href');
        var target = href === '#' ? null : document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Reveal on scroll
    function initReveal() {
      var r = $$('.reveal');
      if (!('IntersectionObserver' in window)) {
        r.forEach(function(el) { el.classList.add('active'); });
        return;
      }
      var o = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) entry.target.classList.add('active');
        });
      }, { threshold: 0.1 });
      r.forEach(function(el) { o.observe(el); });
    }
    initReveal();
    document.addEventListener('astro:page-load', initReveal);
  })();
</script>
</body>
</html>
