---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import { site, type NavItem } from '../data/site';

export interface Props {
  title: string;
  description?: string;
  activeNav?: string;
}

const {
  title,
  description = 'Училищно радио 32 Подкаст — подкастът на 32. СУИЧЕ. Междучасие и SPECIAL — нови епизоди всяка седмица.',
  activeNav = '',
} = Astro.props;

const fullTitle = title.includes('32 Подкаст') ? title : `${title} | 32 Подкаст`;
---

<!doctype html>
<html lang="bg">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#ff3d00">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script is:inline>
  (function(){
    var t = localStorage.getItem('theme');
    if (!t) t = window.matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', t);
  })();
</script>
</head>
<body>
<div class="noise-overlay" aria-hidden="true"></div>
<MobileMenu items={site.navItems} activeNav={activeNav} />
<Navbar items={site.navItems} activeNav={activeNav} />

<main>
  <slot />
</main>

<Footer items={site.navItems} />

<script is:inline>
  (function() {
    function $(s, c) { return (c || document).querySelector(s); }
    function $$(s, c) { return Array.prototype.slice.call((c || document).querySelectorAll(s)); }

    // Password protection - client-side only
    const PASSWORD = 'podcastoftheyear';
    
    function checkAuth() {
      const sessionPassword = sessionStorage.getItem('sitePassword');
      const urlParams = new URLSearchParams(window.location.search);
      const urlPassword = urlParams.get('password');
      return sessionPassword === PASSWORD || urlPassword === PASSWORD;
    }

    // If not authenticated, show password overlay
    if (!checkAuth()) {
      document.body.style.overflow = 'hidden';
      const overlay = document.createElement('div');
      overlay.className = 'password-overlay';
      overlay.innerHTML = `
        <div class="password-box">
          <div class="password-header">
            <h1>32 Подкаст</h1>
            <p>Сайтът е в процес на преработка. Въведете паролата за достъп.</p>
          </div>
          <form id="passwordForm" class="password-form">
            <input 
              type="password" 
              id="passwordInput" 
              placeholder="Парола..." 
              required
              autocomplete="current-password"
              class="password-input"
            />
            <button type="submit" class="password-btn">
              <i class="fas fa-lock"></i> Влез
            </button>
          </form>
          <div id="passwordError" class="password-error" style="display: none;">
            <i class="fas fa-exclamation-triangle"></i> Невалидна парола
          </div>
        </div>
      `;
      document.body.prepend(overlay);

      // Handle form submit
      const form = document.getElementById('passwordForm');
      const input = document.getElementById('passwordInput');
      const errorDiv = document.getElementById('passwordError');
      
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        const password = input.value;
        
        if (password === PASSWORD) {
          sessionStorage.setItem('sitePassword', PASSWORD);
          // Clean URL and reload
          const path = window.location.pathname;
          window.history.replaceState({}, document.title, path);
          window.location.reload();
        } else {
          errorDiv.style.display = 'flex';
          input.style.borderColor = '#ef4444';
          setTimeout(function() {
            input.style.borderColor = '';
          }, 300);
        }
      });
      return; // Don't run rest of init if not authenticated
    }

    // Navbar scroll shadow
    var header = $('.navbar');
    if (header) {
      window.addEventListener('scroll', function() {
        header.classList.toggle('scrolled', window.scrollY > 50);
      });
    }

    // Mobile menu
    window.toggleMobileMenu = function() {
      $('#mobileMenu').classList.toggle('open');
      $('#mobileOverlay').classList.toggle('open');
      document.body.style.overflow = $('#mobileMenu').classList.contains('open') ? 'hidden' : '';
    };

    // Theme dropdown
    window.toggleDropdown = function(e) {
      e.stopPropagation();
      $('#themeDropdown').classList.toggle('open');
    };

    window.setTheme = function(n) {
      document.documentElement.setAttribute('data-theme', n);
      localStorage.setItem('theme', n);
      var d = $('#themeDropdown'); if (d) d.classList.remove('open');
      var i = $('#themeIcon');
      if (i) i.className = n === 'light' ? 'fas fa-sun' : n === 'dark' ? 'fas fa-moon' : 'fas fa-palette';
      $$('.theme-dropdown-menu button').forEach(function(b) {
        b.classList.toggle('active', b.getAttribute('data-theme') === n);
      });
    };
    document.addEventListener('click', function() {
      var d = $('#themeDropdown'); if (d) d.classList.remove('open');
    });

    // Init theme icon + active button on page load
    (function() {
      var t = document.documentElement.getAttribute('data-theme');
      var i = $('#themeIcon');
      if (i) i.className = t === 'light' ? 'fas fa-sun' : t === 'dark' ? 'fas fa-moon' : 'fas fa-palette';
      $$('.theme-dropdown-menu button').forEach(function(b) {
        b.classList.toggle('active', b.getAttribute('data-theme') === t);
      });
    })();

    // Smooth scroll for in-page anchors
    $$('a[href^="#"]').forEach(function(a) {
      a.addEventListener('click', function(e) {
        var href = a.getAttribute('href');
        var target = href === '#' ? null : document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Reveal on scroll
    function initReveal() {
      var r = $$('.reveal');
      if (!('IntersectionObserver' in window)) {
        r.forEach(function(el) { el.classList.add('active'); });
        return;
      }
      var o = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) entry.target.classList.add('active');
        });
      }, { threshold: 0.1 });
      r.forEach(function(el) { o.observe(el); });
    }
    initReveal();
    document.addEventListener('astro:page-load', initReveal);
  })();
</script>
</body>
</html>